9. Gaussian Process and its Application
import numpy as np
import matplotlib.pyplot as plt
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import RBF, ConstantKernel
# Objective function
def objective_function(x):
 return x**2 + np.sin(x)
# Training data
X = np.array([-4, -3, -2, -1, 0, 1, 2, 3, 4]).reshape(-1, 1)
# Function values
y = objective_function(X.ravel())
# Create Gaussian Process kernel
kernel = ConstantKernel(1.0) * RBF(length_scale=1.0)
# Create Gaussian Process model
model = GaussianProcessRegressor(
 kernel=kernel,
 random_state=42
)
# Train the model
model.fit(X, y)
# Test points
X_test = np.linspace(-5, 5, 100).reshape(-1, 1)
# Prediction
y_pred, y_std = model.predict(X_test, return_std=True)
# Display predictions
print("Gaussian Process Surrogate Model")
print("--------------------------------")
test_values = [-3.5, -1.5, 0.5, 1.5, 3.5]
for x in test_values:
 prediction, uncertainty = model.predict(
 [[x]],
 return_std=True
 )
 print("x =", x)
 print("Predicted Value =", prediction[0])
 print("Uncertainty =", uncertainty[0])
 print()
# Plot actual function
plt.plot(
 X_test,
 objective_function(X_test.ravel()),
 label="Actual Function"
)
# Plot GP prediction
plt.plot(
 X_test,
 y_pred,
 label="GP Prediction"
)
# Plot uncertainty
plt.fill_between(
 X_test.ravel(),
 y_pred - 2 * y_std,
 y_pred + 2 * y_std,
 alpha=0.2,
 label="95% Confidence Interval"
)
# Training points
plt.scatter(
 X,
 y,
 label="Training Data"
)
plt.xlabel("X")
plt.ylabel("Function Value")
plt.title("Gaussian Process Surrogate Model")
plt.legend()
plt.show()


10. Path Finding using Ant Colony Optimization
import numpy as np
import random
# Nodes
nodes = ['A', 'B', 'C', 'D', 'E', 'F']
# Distance matrix
distance = np.array([
 [0, 2, 4, 0, 0, 0], # A
 [2, 0, 1, 3, 0, 0], # B
 [4, 1, 0, 0, 2, 0], # C
 [0, 3, 0, 0, 1, 5], # D
 [0, 0, 2, 1, 0, 2], # E
 [0, 0, 0, 5, 2, 0] # F
])
# Parameters
num_ants = 20
iterations = 50
alpha = 1
beta = 2
evaporation = 0.5
# Initial pheromone
pheromone = np.ones((6, 6))
# Source and destination
source = 0 # A
destination = 5 # F
def find_path():
 current = source
 path = [current]
 while current != destination:
 # Find connected nodes
 neighbors = [
 i for i in range(6)
 if distance[current][i] > 0 and i not in path
 ]
 if not neighbors:
 return None
 # Calculate probability
 probabilities = []
 for next_node in neighbors:
 tau = pheromone[current][next_node]
 eta = 1 / distance[current][next_node]
 probability = (tau ** alpha) * (eta ** beta)
 probabilities.append(probability)
 # Normalize probabilities
 probabilities = np.array(probabilities)
 probabilities = probabilities / probabilities.sum()
 # Select next node
 next_node = random.choices(
 neighbors,
 weights=probabilities,
 k=1
 )[0]
 path.append(next_node)
 current = next_node
 return path
best_path = None
best_length = float('inf')
# ACO iterations
for iteration in range(iterations):
 paths = []
 # Generate paths
 for ant in range(num_ants):
 path = find_path()
 if path is not None:
 length = 0
 for i in range(len(path) - 1):
 length += distance[path[i]][path[i + 1]]
 paths.append((path, length))
 # Store best path
 if length < best_length:
 best_length = length
 best_path = path
 # Evaporation
 pheromone *= (1 - evaporation)
 # Deposit pheromone
 for path, length in paths:
 deposit = 1 / length
 for i in range(len(path) - 1):
 a = path[i]
 b = path[i + 1]
 pheromone[a][b] += deposit
 pheromone[b][a] += deposit
# Display result
print("Ant Colony Optimization")
print("-----------------------")
print("Source :", nodes[source])
print("Destination :", nodes[destination])
print("Best Path :", end=" ")
for node in best_path:
 print(nodes[node], end=" ")
print()
print("Path Length :", best_length)
