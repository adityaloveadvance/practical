5. Quasi-Newton Method to Find Local Maxima
import numpy as np
from scipy.optimize import minimize
# Function whose maximum is required
def f(x):
 return -(x[0] - 3)**2 + 9
# To find maximum, minimize the negative of the function
def objective(x):
 return -f(x)
# Initial value
x0 = [0]
# Quasi-Newton method: BFGS
result = minimize(objective, x0, method='BFGS')
# Display result
print("Quasi-Newton Method (BFGS)")
print("--------------------------------")
print("Optimal x =", round(result.x[0], 4))
print("Maximum value =", round(f(result.x), 4))
print("Number of iterations =", result.nit)
print("Success =", result.success)


6. Adagrad, RMSprop and Adadelta
import math
x = 10.0
learning_rate = 1.0
epsilon = 1e-8
G = 0.0
print("AdaGrad Optimization")
print("--------------------")
for i in range(10):
    gradient = 2 * x
    G = G + gradient**2
    x = x - (learning_rate / (math.sqrt(G) + epsilon)) * gradient
    print("Iteration", i + 1, ": x =", round(x, 4), "f(x) =", round(x**2, 4))
print("\nFinal x =", round(x, 4))
print("Minimum value =", round(x**2, 4))
x = 10.0
learning_rate = 0.1
decay = 0.9
E = 0.0
print("\\nRMSprop Optimization")
print("--------------------")
for i in range(10):
    gradient = 2 * x
    E = decay * E + (1 - decay) * gradient**2
    x = x - (learning_rate / (math.sqrt(E) + epsilon)) * gradient
    print("Iteration", i + 1, ": x =", round(x, 4), "f(x) =", round(x**2, 4))
x = 10.0
rho = 0.95
eps = 1e-6
Eg = 0.0
Edx = 0.0
print("\\nAdadelta Optimization")
print("---------------------")
for i in range(10):
    gradient = 2 * x
    Eg = rho * Eg + (1 - rho) * gradient**2
    dx = -(math.sqrt(Edx + eps) / math.sqrt(Eg + eps)) * gradient
    Edx = rho * Edx + (1 - rho) * dx**2
    x = x + dx
    print("Iteration", i + 1, ": x =", round(x, 4), "f(x) =", round(x**2, 4))


7. Radial Basis Functions using Surrogate Modelling
import numpy as np
import matplotlib.pyplot as plt
X = np.array([0, 1, 2, 3, 4, 5])
y = np.sin(X)
def rbf(x, center, epsilon=1.0):
 return np.exp(-((x - center) / epsilon) ** 2)
Phi = np.zeros((len(X), len(X)))
for i in range(len(X)):
 for j in range(len(X)):
 Phi[i, j] = rbf(X[i], X[j])
weights = np.linalg.solve(Phi, y)
def predict(x):
 result = 0
 for i in range(len(X)):
 result += weights[i] * rbf(x, X[i])
 return result
X_test = np.linspace(0, 5, 100)
y_pred = np.array([predict(x) for x in X_test])
print("RBF Surrogate Model")
print("-------------------")
for x in [0.5, 1.5, 2.5, 3.5, 4.5]:
 print("x =", x, "Predicted =", predict(x))
plt.scatter(X, y, label="Actual Data")
plt.plot(X_test, y_pred, label="RBF Surrogate")
plt.xlabel("X")
plt.ylabel("Function Value")
plt.title("Radial Basis Function Surrogate Model")
plt.legend()
plt.show()


